{
  "name": "candela-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "analytics:report": "node scripts/analytics-report.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "oxlint",
    "test": "node --test scripts/prerender.test.mjs && vitest run src functions",
    "preview": "vite preview",
    "d1:migrate:local": "wrangler d1 migrations apply candela-site-analytics --local",
    "d1:migrate:remote": "wrangler d1 migrations apply candela-site-analytics --remote"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "turndown": "^7.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
